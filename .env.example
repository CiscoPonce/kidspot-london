# Database Configuration
DB_PASSWORD=your_secure_password_here_32_chars_minimum

# Discovery API Keys
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
APIFY_TOKEN=your_apify_token_here
APIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Admin Key (for sponsor management)
ADMIN_KEY=your_admin_key_here_32_chars_minimum

# Database Connection
DATABASE_URL=postgres://kidspot_admin:your_secure_password_here@localhost:5432/kidspot

# Redis Connection
REDIS_URL=redis://localhost:6379

# Node Environment
NODE_ENV=development

# Port Configuration
API_PORT=4000

# Foursquare Places API
FOURSQUARE_API_KEY=your_foursquare_service_key_here

GEOAPIFY_API_KEY=your_geoapify_api_key_here

# NVIDIA API (Phase 18B — LLM fallback extraction)
NVIDIA_API_KEY=nvapi-3crC5u8-...your_key_here
NVIDIA_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_MAX_TOKENS=16384
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
